#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: ./update-status --service <name> --status <up|down|degraded> --message <msg>"
  echo ""
  echo "Updates the status of a service, then commits and pushes."
  echo ""
  echo "If data/status.yaml.gpg exists (encrypted mode), decrypts it first,"
  echo "updates the status, re-encrypts, and commits the encrypted file."
  echo "Falls back to plaintext status.yaml if no encrypted file exists."
  echo ""
  echo "Options:"
  echo "  --service   Service name (required)"
  echo "  --status    One of: up, down, degraded (required)"
  echo "  --message   Status message (required)"
  exit 1
}

SERVICE=""
STATUS=""
MESSAGE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --service)  SERVICE="$2"; shift 2 ;;
    --status)   STATUS="$2"; shift 2 ;;
    --message)  MESSAGE="$2"; shift 2 ;;
    --help|-h)  usage ;;
    *)          echo "Unknown option: $1"; usage ;;
  esac
done

if [[ -z "$SERVICE" || -z "$STATUS" || -z "$MESSAGE" ]]; then
  echo "Error: --service, --status, and --message are all required."
  usage
fi

if [[ "$STATUS" != "up" && "$STATUS" != "down" && "$STATUS" != "degraded" ]]; then
  echo "Error: --status must be one of: up, down, degraded"
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

ENC_PATH="data/status.yaml.gpg"
PLAIN_PATH="status.yaml"

if [[ -f "$ENC_PATH" ]]; then
  # Encrypted mode: decrypt → update → re-encrypt
  echo "Decrypting status data..."
  gpg --batch --yes --decrypt --output "$PLAIN_PATH" "$ENC_PATH"

  echo "Updating service '$SERVICE' → $STATUS..."
  node --experimental-strip-types "$SCRIPT_DIR/scripts/yaml-update.ts" \
    --service "$SERVICE" \
    --status "$STATUS" \
    --message "$MESSAGE"

  echo "Re-encrypting status data..."
  RECIPIENT=$(gpg --import-options show-only --import data/public.gpg 2>&1 | grep -oP '[A-F0-9]{40}' | head -1)
  gpg --encrypt --armor --trust-model always \
    --recipient "$RECIPIENT" \
    --output "$ENC_PATH.tmp" \
    "$PLAIN_PATH"
  mv "$ENC_PATH.tmp" "$ENC_PATH"
  rm -f "$PLAIN_PATH"

  echo "Committing and pushing..."
  git add "$ENC_PATH"
  git commit -m "status: update $SERVICE to $STATUS"
  git push
else
  # Plaintext mode (pre-encryption setup)
  echo "Updating service '$SERVICE' → $STATUS..."
  node --experimental-strip-types "$SCRIPT_DIR/scripts/yaml-update.ts" \
    --service "$SERVICE" \
    --status "$STATUS" \
    --message "$MESSAGE"

  echo "Committing and pushing..."
  git add "$PLAIN_PATH"
  git commit -m "status: update $SERVICE to $STATUS"
  git push
fi

echo "Done. Status page will rebuild automatically."
